# Public app — copy to .env here. Restart `npm start` after changes.

# API base including /api (use one or both; REACT_APP_API_URL wins if both set)
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_API_BASE=http://localhost:5000/api

# Google Web Client ID — same as GOOGLE_CLIENT_ID in backend/.env
REACT_APP_GOOGLE_CLIENT_ID=
