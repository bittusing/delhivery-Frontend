# Local — copy to .env and restart npm start
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_API_BASE=http://localhost:5000/api
REACT_APP_GOOGLE_CLIENT_ID=

# Production build (set these in your host: Vercel / Netlify / CI env — NOT only on your laptop)
# REACT_APP_API_URL=https://api.flywelllogistics.com/api
# REACT_APP_GOOGLE_CLIENT_ID=<same Web client ID as backend GOOGLE_CLIENT_ID on api.flywelllogistics.com>
# Google Cloud → OAuth Web client → Authorized JavaScript origins must include:
#   https://www.flywelllogistics.com
# Then rebuild + redeploy the frontend after changing any REACT_APP_* variable.
